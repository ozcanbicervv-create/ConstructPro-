    "framer-motion": "12.23.12",
    "input-otp": "1.4.2",
    "lucide-react": "0.525.0",
    "next": "15.5.2",
    "next-auth": "4.24.11",
    "next-intl": "4.3.6",
    "next-themes": "0.4.6",
    "prisma": "6.15.0",
    "react": "19.1.1",
    "react-day-picker": "9.9.0",
    "react-dom": "19.1.1",
    "react-hook-form": "7.62.0",
