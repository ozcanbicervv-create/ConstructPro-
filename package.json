    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-testing-library": "7.6.8",
    "husky": "9.1.7",
    "jest": "30.1.3",
    "jest-environment-jsdom": "30.1.2",
    "jest-extended": "4.0.2",
    "lighthouse": "12.8.2",
    "lint-staged": "16.1.6",
    "msw": "2.11.1",
    "nodemon": "3.1.10",
    "npm-check-updates": "17.1.18",
    "prettier": "3.6.2",
    "prettier-plugin-tailwindcss": "0.6.14",
    "puppeteer": "23.11.1",
    "rimraf": "6.0.1",
    "tailwindcss": "^4",
    "ts-jest": "29.4.1",
    "ts-node": "10.9.2",
    "tw-animate-css": "1.3.8",
    "typescript": "5.9.2",
    "wait-on": "8.0.4",
    "web-vitals": "4.2.4",
    "webpack-bundle-analyzer": "4.10.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,css,scss,yaml,yml}": [
      "prettier --write"
    ]
  }
}
