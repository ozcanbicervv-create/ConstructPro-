{
  "name": "constructpro",
  "version": "0.1.0",
  "private": true,
  "description": "Construction project management and collaboration platform built with Next.js, TypeScript, and modern web technologies",
  "keywords": [
    "construction",
    "project-management",
    "nextjs",
    "typescript",
    "real-time",
    "collaboration"
  ],
  "author": "Vovelet-Tech",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/vovelet-tech/constructpro.git"
  },
  "bugs": {
    "url": "https://github.com/vovelet-tech/constructpro/issues"
  },
  "homepage": "https://github.com/vovelet-tech/constructpro#readme",
  "engines": {
    "node": ">=18.17.0",
    "npm": ">=9.0.0"
  },
  "scripts": {
    "dev": "nodemon --exec \"npx tsx server.ts\" --watch server.ts --watch src --ext ts,tsx,js,jsx",
    "dev:debug": "cross-env NODE_OPTIONS=--inspect npm run dev",
    "dev:turbo": "next dev --turbo",
    "build": "next build",
    "build:analyze": "ANALYZE=true npm run build",
    "build:production": "cross-env NODE_ENV=production npm run build",
    "start": "node start.js",
    "start:production": "cross-env NODE_ENV=production npm run start",
    "preview": "npm run build && npm run start",
    "clean": "rimraf .next out dist coverage node_modules/.cache",
    "clean:all": "npm run clean && rimraf node_modules package-lock.json",
    "reinstall": "npm run clean:all && npm install",
    "lint": "next lint",
    "lint:fix": "eslint . --fix",
    "lint:strict": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "type-check:watch": "tsc --noEmit --watch",
    "test": "jest --config jest.config.simple.js",
    "test:watch": "jest --config jest.config.simple.js --watch",
    "test:coverage": "jest --config jest.config.simple.js --coverage",
    "test:ci": "jest --config jest.config.simple.js --ci --coverage --watchAll=false",
    "test:unit": "jest --config jest.config.simple.js --testPathPattern=src",
    "test:integration": "jest --config jest.config.js --testPathPattern=tests/integration",
    "test:e2e": "node scripts/e2e-deployment-tests.js",
    "test:e2e:local": "node scripts/e2e-deployment-tests.js http://localhost:3000",
    "test:deployment": "node scripts/deployment-tests.js",
    "test:deployment:local": "node scripts/deployment-tests.js http://localhost:3000",
    "test:health": "node scripts/health-check.js",
    "test:health:local": "node scripts/health-check.js http://localhost:3000",
    "test:security": "npm audit --audit-level moderate",
    "security:audit": "node scripts/security-audit.js",
    "security:scan": "npm audit --audit-level moderate",
    "security:headers": "node -e \"console.log('Security headers configured in middleware')\"",
    "test:performance": "npm run lighthouse",
    "performance:benchmark": "node scripts/performance-benchmark.js full",
    "performance:lighthouse": "node scripts/performance-benchmark.js lighthouse",
    "performance:baseline": "node scripts/performance-benchmark.js baseline",
    "performance:compare": "node scripts/performance-benchmark.js full",
    "bundle:analyze": "node scripts/analyze-bundle.js analyze",
    "bundle:compare": "node scripts/analyze-bundle.js compare",
    "bundle:baseline": "node scripts/analyze-bundle.js baseline",
    "test:all": "npm run test:ci && npm run test:e2e:local && npm run test:security",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:pull": "prisma db pull",
    "db:migrate": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:migrate:reset": "prisma migrate reset",
    "db:migrate:status": "prisma migrate status",
    "db:reset": "prisma migrate reset --force",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "db:backup": "node scripts/maintenance.js backup",
    "db:restore": "node scripts/maintenance.js restore",
    "db:list-backups": "node scripts/maintenance.js list",
    "db:cleanup": "node scripts/maintenance.js cleanup",
    "db:maintenance": "node scripts/maintenance.js",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "deploy:validate": "node scripts/validate-build.js",
    "deploy:test": "npm run build && npm run start & sleep 15 && npm run test:e2e:local && pkill -f 'tsx server.ts'",
    "deploy:staging": "echo 'Deploy to staging environment'",
    "deploy:production": "echo 'Deploy to production environment'",
    "ci:install": "npm ci --prefer-offline --no-audit",
    "ci:quality": "npm run lint:strict && npm run type-check && npm run format:check",
    "ci:test": "npm run test:ci",
    "ci:build": "npm run build:production",
    "ci:security": "npm audit --audit-level moderate && npm run test:security",
    "ci:performance": "npm run test:performance",
    "ci:all": "npm run ci:quality && npm run ci:test && npm run ci:build && npm run ci:security",
    "setup": "node scripts/setup-dev.js",
    "setup:clean": "npm run clean:all && npm install && npm run setup",
    "check:env": "node scripts/check-environment.js",
    "prepare": "husky",
    "postinstall": "npm run db:generate",
    "precommit": "lint-staged",
    "prepush": "npm run type-check && npm run test:unit",
    "lighthouse": "lhci autorun",
    "bundle-analyze": "ANALYZE=true npm run build",
    "deps:check": "npm outdated",
    "deps:update": "npm update",
    "deps:audit": "npm audit",
    "deps:audit:fix": "npm audit fix",
    "security:fix": "npm audit fix",
    "maintenance:cleanup": "npm run clean && npm run deps:audit:fix",
    "maintenance:update": "npm run deps:update && npm run deps:audit:fix",
    "logs:clear": "rimraf logs/*.log",
    "cache:clear": "rimraf .next/cache node_modules/.cache",
    "docker:build": "docker build -t constructpro .",
    "docker:run": "docker run -p 3000:3000 constructpro",
    "docker:dev": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:clean": "docker system prune -f",
    "version:patch": "npm version patch",
    "version:minor": "npm version minor",
    "version:major": "npm version major",
    "release:prepare": "npm run ci:all && npm run deploy:validate",
    "release:patch": "npm run release:prepare && npm run version:patch",
    "release:minor": "npm run release:prepare && npm run version:minor",
    "release:major": "npm run release:prepare && npm run version:major",
    "docs:generate": "node scripts/generate-api-docs.js",
    "docs:validate": "node scripts/generate-api-docs.js --validate-only",
    "docs:test": "node scripts/test-api-docs.js",
    "docs:serve": "npm run dev",
    "docs:build": "npm run docs:generate && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
