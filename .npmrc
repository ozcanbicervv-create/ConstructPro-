# NPM Configuration for ConstructPro

# Performance optimizations
prefer-offline=true
progress=true
audit-level=moderate

# Security settings
fund=false
save-exact=true

# Development settings
engine-strict=true
legacy-peer-deps=false

# Cache settings
prefer-online=true

# Registry settings (uncomment if using private registry)
# registry=https://registry.npmjs.org/

# Logging
loglevel=warn